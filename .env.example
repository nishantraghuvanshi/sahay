# Care API
CARE_API_TOKEN=
DATABASE_URL=postgresql://kinvox:kinvox@localhost:5432/kinvox
PUBLIC_BASE_URL=
RESUME_WINDOW_MIN=15

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# Escalation delivery + phone OTP (WhatsApp Cloud API)
# WhatsApp is not SMS, so India's DLT registration does not apply — this is the
# route to real phone OTP that can go live today. Needs an approved
# *authentication* template; a marketing/utility one will not carry a code.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=otp_verification
WHATSAPP_OTP_LANG=en
# true if your approved template has a copy-code button (most do). Mismatch
# fails the send with Meta error 132000.
WHATSAPP_OTP_HAS_BUTTON=false

# Reasoning layer on the Hive stack (V1)
HIVE_ROUTER_URL=
HIVE_ROUTER_KEY=

# Prescription reading (api/rx_extract).
# Provider defaults to google/gemini-3.5-flash-lite — the live-verified baseline.
# The key is read at API startup; a missing one is reported on /health rather than
# discovered on the first uploaded prescription.
# Set provider/model/key together — the key variable name follows the provider
# (google -> GOOGLE_API_KEY, openai -> OPENAI_API_KEY), unless
# PIPELINE_B_API_KEY_ENV overrides it. See api/rx_extract/README.md for the table.
PIPELINE_B_PROVIDER=google
PIPELINE_B_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# The key variable is derived from the provider; override it when your key lives
# under another name (e.g. GEMINI_API_KEY rather than GOOGLE_API_KEY).
# PIPELINE_B_API_KEY_ENV=GEMINI_API_KEY
# OPENAI_API_KEY=      # for PIPELINE_B_PROVIDER=openai (model gpt-5-nano)
# Optional overrides: PIPELINE_B_TIMEOUT (default 60s), PIPELINE_B_MAX_ATTEMPTS
# (default 3; use 7 on Groq, whose free tier allows roughly 2 documents/minute).

# ElevenLabs agent transport (agent/). The webhook secret is REQUIRED when
# active.transport is elevenlabs: the tool endpoint is reachable through a public
# tunnel and report_outcome can alert the patient's family, so the route fails
# closed if this is unset. Generate any long random string; both sides read it here.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Origins allowed to call the Care API. Vite dev server by default.
CORS_ORIGINS=http://localhost:5173
# ---------------------------------------------------------------- caregiver auth
# Screens 1a / 2a. api/config.py is the authority on these names and defaults.

# Origin(s) allowed to send the session cookie. Comma-separated, exact — a
# wildcard is rejected by browsers whenever credentials are involved.
APP_ORIGIN=http://localhost:5173

SESSION_COOKIE_NAME=kv_session
SESSION_TTL_DAYS=30
# false in local dev only: http://localhost has no TLS and a Secure cookie is
# dropped there. MUST be true on any real domain.
COOKIE_SECURE=false

# HMAC key for OTP hashing. Rotate after the event (NFR-7). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Boot fails if this is shorter than 16 chars — a blank pepper would make every
# stored OTP forgeable by anyone who knows the algorithm.
OTP_PEPPER=
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_S=30
OTP_MAX_PER_DESTINATION_HOUR=5
OTP_MAX_PER_IP_HOUR=20

# Email OTP delivery (steps 3-4 of signup).
# SMTP wins over Resend when both are set: Resend's shared `resend.dev` sender
# only delivers to the account holder, so a caregiver entering their own address
# would never receive the code. Gmail needs an app password (2FA required):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=

# Demo fallback for Indian A2P SMS that is not DLT-registered: these numbers get
# DEV_OTP_BYPASS_CODE and no carrier hop. Everything else — hashing, expiry,
# attempt counting, session issue — runs exactly as in production.
# Team phones only, with consent (SR-7). Leave EMPTY in any real deployment.
#
# A single `*` bypasses EVERY phone number — the demo setting for a build with
# no WhatsApp sender approved. It is a master key for phone login: anyone with
# the code below signs in as any number. Never leave it set with real
# caregivers on the deployment.
# `*` works the same for email, and is switched independently — the two
# channels break for different reasons and get fixed at different times.
DEV_OTP_BYPASS_NUMBERS=
DEV_OTP_BYPASS_EMAILS=
DEV_OTP_BYPASS_CODE=424242

# Caregiver app (app/.env.local) — the single integration switch.
# Unset = mock mode. Set to the Care API origin at integration.
# Never put CARE_API_TOKEN here: anything VITE_-prefixed ships in the browser bundle.
VITE_API_BASE=

# ---------------------------------------------------------------------- billing
# FR-29 / FR-30. There is no payment gateway here on purpose: Razorpay and
# Cashfree both need merchant KYC that takes 1-2 working days at best, and this
# build had hours. So money arrives as an ordinary UPI transfer to the VPA below
# and the bank tells the server nothing.
#
# What makes that reconcilable rather than a guess: every open order is issued a
# unique paise suffix (Care is 499.01, 499.02, ...), so exactly one order can be
# awaiting any given amount. The buyer types back the 12-digit UTR, a human
# matches the credit in their UPI app, and scripts/confirm_payment.py grants the
# month. Confirmation has no HTTP route — it is the step that grants a paid
# month and there is no operator login in this build to put in front of it.
#
# Empty is a supported state: /app/billing/plans reports configured:false and
# the checkout screen says payments are not switched on, instead of drawing a QR
# code that points nowhere.
#
# Any UPI app's VPA works — BHIM, GPay, PhonePe. BHIM lets you create a second
# VPA on the same bank account, which is worth doing: Kinvox credits then stay
# separate from your own in the payment history you are reconciling against.
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=Kinvox
# Minutes an unpaid order holds its amount before the suffix is released.
PAYMENT_WINDOW_MIN=30

# Grant the month the moment a buyer types a UTR, with nobody checking the bank.
# The server cannot tell a real 12-digit reference from twelve invented digits,
# so ON means anyone signed in can type any number and get a paid month. Demo
# only; leave false in any deployment real caregivers can reach. Payments it
# confirms are stamped `confirmed_by = 'auto — unverified claim'`, so a row
# granted on trust is never mistaken for one a person verified.
BILLING_AUTOCONFIRM=false
