# Care API origin. Leave unset for live, same-origin through the vite dev proxy —
# that keeps the session cookie SameSite=Lax. Set it to /mock to run the app
# against the built-in fixture with no backend at all.
# VITE_API_BASE=/mock

# Prescription extraction (POST /extract). Not proxied by vite, so this is an
# absolute origin. Leave unset to use the bundled fixture instead of a real read.
# VITE_EXTRACT_API_BASE=http://localhost:8000

# Auth and onboarding. Never mocked. Unset = same-origin through the dev proxy.
# VITE_AUTH_BASE=

# Dev only (ignored in production builds): fake session, dummy onboarding draft,
# and open straight on /setup/prescription.
VITE_DEV_MODE=false

# Voice agent bridge server (agent/). The /setup/meet playground opens a
# WebSocket against this origin. Leave unset to use http://localhost:3001;
# set it to '' to go same-origin behind a reverse proxy.
# VITE_AGENT_BASE=http://localhost:3001
