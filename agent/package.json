{
  "name": "elderly-voice-agent",
  "version": "0.1.0",
  "description": "Modular voice agent for elderly medication adherence — Vapi + Sarvam AI bridge server with plug-and-play provider abstraction",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-timeout=10000 tests/*.test.js",
    "create-assistant": "node scripts/create-assistant.js",
    "update-assistant": "node scripts/update-assistant.js",
    "make-call": "node scripts/make-call.js",
    "simulate": "node scripts/run-simulation.js",
    "generate-tools": "node scripts/generate-tools.js",
    "setup-elevenlabs": "node scripts/setup-elevenlabs-agent.js",
    "setup-elevenlabs-webhook": "node scripts/setup-elevenlabs-webhook.js",
    "simulate-elevenlabs": "node scripts/simulate-elevenlabs-call.js",
    "replay-post-call": "node scripts/replay-post-call.js"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "js-yaml": "^4.1.0",
    "libsql": "^0.5.29",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
