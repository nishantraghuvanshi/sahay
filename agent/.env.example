# ── Voice Agent Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your values.

# Sarvam AI API key (required for STT, LLM, TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Groq API key (optional — alternative LLM provider)
GROQ_API_KEY=your_groq_api_key_here

# API key for authenticating HTTP and WebSocket requests
# If not set, auth is disabled (development mode)
API_KEY=your_shared_secret_api_key_here

# SQLite database path (relative to project root or absolute)
# If not set, falls back to console logging (no persistence)
DB_PATH=./data/voiceagent.db

# Server port
PORT=3001

# Vapi configuration (for telephony integration)
VAPI_ASSISTANT_ID=
VAPI_PRIVATE_KEY=
WEBHOOK_URL=http://localhost:3001

# ── Escalation alerts (PILOT-PLAN.md §2.4) ─────────────────────────
# Where ESCALATED_SYMPTOM alerts go. If unset, escalations are logged
# loudly but NOBODY is notified — do not run a pilot in that state.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_OPERATOR_CONTACT=
ALERT_CHANNEL=telegram
