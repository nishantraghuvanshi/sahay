# ── Voice Agent Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your values:  cp .env.example .env
# NEVER commit .env. The repo is public.
#
# Which keys you need depends on config/providers.yaml `active:`.
# As configured today:  stt: sarvam (bridge) · llm: openai (bridge) · tts: elevenlabs (native)
#
# "bridge" = audio/tokens flow through THIS server, so the key lives here.
# "native" = Vapi calls the provider directly on the PHONE path, so the key
#            also has to be set in the Vapi dashboard.
#
# ElevenLabs is BOTH, and needs the key in BOTH places:
#   phone path   → Vapi calls ElevenLabs directly (key in the Vapi dashboard)
#   /playground  → bridged through src/adapters/providers/tts/elevenlabs.js,
#                  which reads ELEVENLABS_API_KEY here and THROWS without it
# Set it in the dashboard AND below, or the playground has no voice.

# ── Providers (bridge only) ────────────────────────────────────────

# Sarvam AI — speech-to-text. Indic-specialised, which is why it is here
# rather than a generic STT.  https://dashboard.sarvam.ai  → API Keys
SARVAM_API_KEY=

# OpenAI — the active LLM (providers.yaml:34 → api_key_env at :95).
# REQUIRED. Boot fails without it while llm: openai is active.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs — text-to-speech. Required for /playground (bridged); the
# phone path needs the same key set in the Vapi dashboard instead.
# elevenlabs.io → Profile → API Key
# Voice is pinned in providers.yaml: voice_id QTKSa2Iyv0yoxvXY2V8a,
# model eleven_turbo_v2_5. Both UNVERIFIED against a live Vapi call.
ELEVENLABS_API_KEY=

# Groq — only needed if you switch providers.yaml to `llm: groq`.
# Leave blank otherwise.  https://console.groq.com/keys
GROQ_API_KEY=

# ── Telephony (Vapi) ───────────────────────────────────────────────

# https://dashboard.vapi.ai → Settings → API Keys → PRIVATE key.
# The public key is for browser SDKs and will not work here.
VAPI_PRIVATE_KEY=

# Written by `npm run create-assistant`. Leave blank on first setup.
VAPI_ASSISTANT_ID=

# MUST be public HTTPS — Vapi calls it, so localhost cannot work even
# though every provider above is bridged. Set it to your deployment or
# tunnel origin, with NO trailing slash. The server exposes {WEBHOOK_URL}/webhook,
# and that exact URL goes in the Vapi phone number's Server URL field.
WEBHOOK_URL=

# ── Twilio (only for the automated inbound wiring) ─────────────────
# Two ways to point a Twilio number at Vapi:
#   1. Vapi dashboard — import the number there. Needs none of the below.
#   2. `npm run setup-inbound` — sets the number's voice URL via the Twilio
#      API. Needs all three of these.
# Either way, the number must have NO assistant assigned in Vapi, so Vapi
# asks this server who is calling instead of answering with a static greeting.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ── Storage & server ───────────────────────────────────────────────

# REQUIRED. The medication-adherence use case declares requiresPersistence,
# so boot THROWS without this (src/core/persistence-guard.js) — inbound
# context and resume-after-drop are entirely persistence features, and
# without a database they do not fail, they succeed incorrectly.
DB_PATH=./data/voiceagent.db

PORT=3001

# Shared secret guarding the HTTP and WebSocket APIs.
# If unset, auth is DISABLED. Those routes serve patient records, so an
# unset key on a public deployment is a PHI leak. Set it before deploying.
API_KEY=

# REQUIRED (boot refuses to start without it — src/core/safety-guard.js —
# unless ALLOW_INSECURE_LOCAL=1 is set in your own untracked .env; deliberately
# not documented as a line here, same reasoning as API_KEY's opt-out above).
# Shared secret guarding the four
# routes Vapi itself calls and that CANNOT sit behind API_KEY, because Vapi
# is the caller and holds no operator key: /webhook, /llm/chat/completions,
# /api/tts/:provider, and the /api/stt WebSocket. Without it, any reachable
# caller can forge a webhook (fake call records, fabricated symptom text) or
# run up the STT/LLM bill for free.
#
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# After setting this, run `node scripts/generate-assistant-config.js` to bake
# it into config/assistant.json, THEN push it live with
# `node scripts/update-assistant.js --yes`. That covers the assistant's own
# server URLs — it does NOT cover inbound calls: Vapi phone numbers with no
# assistant assigned (this project's inbound setup — see scripts/setup-inbound.js
# and CLAUDE.md) call /webhook using the PHONE NUMBER's own Server URL/Secret,
# configured separately in the Vapi dashboard under that number, not in
# assistant.json. Set the same secret there too, or inbound calls will be
# rejected by vapiSecretAuth once this is deployed.
VAPI_SECRET=

# Minutes a dropped call stays resumable (src/core/inbound/resolve-caller.js).
RESUME_WINDOW_MIN=15

# ── Escalation alerts ──────────────────────────────────────────────
# Where ESCALATED_SYMPTOM / ESCALATED_DISTRESS alerts go. If unset,
# escalations are logged loudly but NOBODY is notified — do not run a
# pilot in that state.
#
# Telegram bot token: message @BotFather → /newbot → copy the token.
# Operator contact: your numeric chat id — message @userinfobot to get it.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_OPERATOR_CONTACT=
ALERT_CHANNEL=telegram

# ── Debugging the first real call ──────────────────────────────────
# Set to a file path to dump every raw Vapi webhook payload. No real Vapi
# payload has been observed yet, so the first live call should run with
# this on — it settles the tool-call shape, endedReason strings, caller-ID
# field and recording URLs in one go.
CAPTURE_WEBHOOKS=

# Seed data — scripts/seed-medications.js
# Test handsets to seed patients against. Placeholders are used when unset; put
# real numbers here (this file's committed copy must keep the placeholders) and
# only ever call phones whose owner has consented (SR-7).
SEED_PATIENT_PHONE=
SEED_PATIENT_PHONE_2=

# Dose scheduler — scripts/seed-medications.js materialises dose_events; this
# is what dials them. OFF by default on purpose: enabling it places REAL phone
# calls to whatever numbers are seeded, on a timer. Only ever enable it against
# handsets whose owner has consented (SR-7).
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=60000

# Run the playground against the multi-state member graph instead of the
# single system prompt. Opt-in: the phone path still uses buildAssistantConfig,
# so this is how you listen to the state machine before it answers a real call.
SQUAD_MODE=false
# ── Telephony (ElevenLabs) ─────────────────────────────────────────
# Only needed when providers.yaml has `active.transport: elevenlabs`
# (the default on this branch). Outbound dose calls only — inbound is
# not handled by this transport. Set TRANSPORT=vapi to override without
# editing providers.yaml.
#
# Uses ELEVENLABS_API_KEY from the section above. That key is
# WORKSPACE-SCOPED: a key from a different workspace sees zero agents and
# zero phone numbers, and every agent PATCH 404s. If that happens, check
# the key's workspace before debugging anything else.

# The Kinvox-owned agent, created by `npm run setup-elevenlabs`, which
# duplicates the prior product's agent rather than mutating it. Leave
# blank on first setup and record the id the script prints.
ELEVENLABS_AGENT_ID=

# OUR shared secret. The adapter sets it as an X-Kinvox-Token request
# header on the tool declarations it installs on the agent, and
# POST /el/tools/:name requires it. Without it that endpoint is open on a
# public tunnel to anyone who learns the URL — and report_outcome can
# raise a real ESCALATED_SYMPTOM alert to a patient's family. Any long
# random string; generate with `openssl rand -hex 32`.
ELEVENLABS_WEBHOOK_SECRET=

# THEIR signing secret (wsec_…), shown once when the workspace post-call
# webhook is created. ElevenLabs signs every post-call delivery
# ("ElevenLabs-Signature: t=<unix>,v0=<hex>" over `${t}.${raw body}`) and
# does NOT send our X-Kinvox-Token, so POST /el/post-call rejects every
# delivery without this.
ELEVENLABS_POST_CALL_SECRET=

# Id of that workspace webhook object. buildAssistantConfig attaches it to
# the agent on boot when set. Creating the webhook needs the `webhooks_manage`
# workspace ROLE — it is not an API-key scope, so widening a key cannot
# substitute; create it in Settings → Webhooks. Until it exists, tool calls
# reach the engine mid-call but call ENDINGS do not, so no outcome is ever
# persisted (outcomes are derived on CONVERSATION_ENDED, which only that
# webhook fires).
ELEVENLABS_POST_CALL_WEBHOOK_ID=
